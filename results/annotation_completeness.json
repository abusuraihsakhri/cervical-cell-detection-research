  "_method": {
    "detector": "Local maxima of the haematoxylin channel (skimage rgb2hed colour deconvolution), Gaussian-smoothed, peaks separated by at least one nucleus radius and above a threshold set between the Otsu stain/background cut and the 99th percentile of stained pixels. Two alternatives (Otsu + connected components; difference-of-Gaussians with a scale filter) were tried and rejected on visual inspection \u2014 see the detect_nuclei docstring.",
    "independence": "Deliberately does not use the trained YOLO model, so its counts cannot inherit the model's blind spots.",
    "known_biases": "Counts leukocyte and inflammatory nuclei, which are not annotatable epithelial cells, so counts run high in inflammatory fields. Undercounts in pale sparse fields and in dense overlapping clumps. This is an order-of-magnitude estimate only. The decisive evidence for the conclusion is documentary, not this detector \u2014 see the dataset_provenance field.",
    "interpretation": "annotated_fraction = ground-truth boxes / detected cells. 1.0 means every visible cell carries a label. Values well below 1.0 mean model 'false positives' may be correct detections of unlabelled cells, so measured precision is a lower bound."
  },
  "_dataset_provenance": {
    "source": "data/sipakmed/mirror_a/README.dataset.txt (Roboflow export of SIPaKMeD)",
    "quote": "The SIPaKMeD Database consists of 4049 images of isolated cells that have been manually extracted from 966 cluster cell images of Pap smear slides. This dataset is a subset of the SIPaKMeD. Only the single-cell images are rearranged for purpose of experiment.",
    "arithmetic": "4049 manually extracted cells / 966 cluster images = 4.19 annotated cells per field. Measured ground-truth density in this project's splits is 4.86 (train) and 4.54 (valid) boxes per image, consistent with that.",
    "conclusion": "SIPaKMeD is a CLASSIFICATION dataset of hand-picked isolated cells, retrofitted into detection boxes. It was never built as exhaustive detection ground truth. The cells carrying boxes were selected for being cleanly isolated and unambiguously classifiable, which is a biased subset of the cells present, not a random one."
  },
  "_manual_verification": {
    "image": "cell_2_9600_400_10100_900_jpg.rf.df8dcd1...",
    "figure": "results/manualcount_cell_2_9600_400_10100_.png",
    "ground_truth_boxes": 2,
    "cells_visible_by_eye": "approximately 55-70 squamous epithelial cells with clearly visible nuclei",
    "annotated_fraction": "roughly 0.03",
    "observation": "Both annotated cells are isolated, well-separated and sit in clear space, while dozens of cells in overlapping sheets carry no label. This matches the provenance exactly: the selection is biased toward isolated cells."
  }
